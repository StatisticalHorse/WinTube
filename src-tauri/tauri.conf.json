{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinTube",
  "version": "0.2.2",
  "identifier": "com.wintube.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YouTube",
        "width": 1360,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 620,
        "backgroundColor": "#0f0f0f",
        "theme": "Dark",
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; media-src https: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
